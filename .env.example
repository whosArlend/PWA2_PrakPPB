# Bore & Barrel — Environment Variables
# Copy this file to .env and fill in the values.

# 1. Supabase Backend Configuration (Recommended)
# Create a free project at https://supabase.com and run supabase_schema.sql in the SQL Editor.
VITE_API_BASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# 2. WhatsApp Checkout Contact Configuration (FEATURE 9)
# Phone number in international format without spaces, hyphens, or '+' (e.g. 6281234567890 or 15550100100).
# Clearly marked placeholder below:
VITE_WHATSAPP_NUMBER=6285290264076

# 3. Legacy University RESTful Backend (Modul 5, if available)
# VITE_API_BASE_URL=https://modlima.fuadfakhruz.id
